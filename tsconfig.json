{
	"compilerOptions": {
		// Module settings optimized for Obsidian plugin
		"module": "ESNext",
		"target": "ES2024",
		"moduleResolution": "bundler",

		// Type checking - only what ESLint can't handle
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": false,
		"useUnknownInCatchVariables": false,

		// Required for esbuild
		"isolatedModules": true,

		// Performance optimizations
		"skipLibCheck": true,
		"noEmit": true,

		// Module interop for npm packages
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,

		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2024"
		]
	},

	"include": [
		"src/**/*.ts"
	],

	"exclude": [
		"node_modules",
		"build",
		"**/*.js",
		"main.js",
		"scripts",
		"tests"
	]
}
