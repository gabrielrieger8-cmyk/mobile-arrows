		"mobile",
		"toolbar",
		"cursor"
	],
	"author": "Gabriel",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.3.1",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.9",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.9.2"
	}
}
