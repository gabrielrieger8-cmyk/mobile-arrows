{
	"name": "mobile-arrows",
	"version": "1.0.0",
	"description": "Setas direcionais na toolbar móvel do Obsidian (cursor por caractere, linha e palavra).",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
